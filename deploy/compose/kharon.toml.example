# kharond config for the compose example (SPEC §9). Every value
# below is a placeholder; kharond refuses unknown keys and refuses to
# start on unsafe combinations (REQ-DEP-003). Check a file with
#   docker compose run --rm kharon --check --config /etc/kharon.toml

[bitwarden]
# "https://vault.bitwarden.eu" for EU accounts, or "http://vaultwarden:80"
# with the `vaultwarden` compose profile.
server = "https://vault.bitwarden.com"
email = "kharon@example.net"
api_key_file = "/run/secrets/kharon_bw_api_key"
organization_id = "00000000-0000-0000-0000-000000000001"
collection_ids = ["00000000-0000-0000-0000-000000000002"]

[agents.assistant]
# `kharon token mint assistant` prints the token once (terminal only)
# and this hash on stdout. Paste the hash here; never put the token here.
token_hash = "$argon2id$..."
# The agent host's Chromium (CDP). Fills need a path to the agent's
# browser. Two ways, pick one:
#  - WireGuard (this line): needs compose.vpn.yml.
#  - Path B over WebSocket (the commented block below): the agent host
#    dials wss://<public host>/connector through the tunnel; no VPN.
# Without a path, MCP calls, grants and approvals still work.
# kharond reads the current /devtools/browser/<id> from /json/version
# on each connect, so a Chromium restart needs no edit.
cdp = { endpoint = "ws://10.66.0.2:9222", via = "wireguard" }
# Path (B) over WebSocket, egress-shaped agent host, no VPN. See
# docs/deployment.md, "Over WebSocket". connector_token_hash comes
# from `kharon tunnel mint`, not `kharon token mint`. [connector] needs
# [public_ingress] below. `listen` is left out on purpose: behind the
# tunnel nothing needs a raw port (set it only to also keep the raw
# pinned-TLS listener, on a VPN address, never a wildcard).
# cdp = { endpoint = "ws://127.0.0.1:9222", via = "agent_connector" }
# The compose base mounts nothing at these paths: bind-mount the cert
# and key with the docker-compose.override.yml in docs/deployment.md
# (Path (B) broker), read-only, key mode 0400 for uid 10001.
# [connector]
# websocket = true
# tls_cert_file = "/etc/kharon/tls.crt"
# tls_key_file = "/etc/kharon/tls.key"

# No [api] section: the agent API is off in this base. With
# compose.vpn.yml, add (the wg address; wildcards are refused,
# REQ-DEP-006):
# [api]
# listen = "10.66.0.1:8787"

# Public gateway (#198): the origin the Cloudflare Tunnel forwards to.
# Agents reach POST /mcp here. Serves only POST /mcp (and GET
# /connector with `[connector] websocket = true`); everything else
# is 404. Loopback needs no TLS, and only what shares the holder's
# namespace (cloudflared) reaches it. Tunnel route: http://127.0.0.1:8790. See
# docs/deployment.md, "Public gateway".
[public_ingress]
listen = "127.0.0.1:8790"
# Set this on any published deploy: requests for another Host get 404.
# public_host = "kharon.example.com"
# Non-loopback peers allowed to set CF-Connecting-IP (throttle key and
# audit client_ip only; never auth). Loopback, this listener, needs none.
# A tailnet cloudflared lists the address it connects from:
# trusted_proxies = ["100.64.0.2"]

[approval]
# ntfy is both the approval-prompt channel (REQ-APR-004) and the
# off-host audit checkpoint sink (REQ-AUD-002): kharond publishes a
# signed checkpoint to this topic every 100 entries or 10 minutes.
# Without this section the daemon refuses to start unless
# [audit] checkpoint_local_only = true is set instead — local-only
# checkpoints are a temporary pilot posture, not the release one.
ntfy = { url = "https://ntfy.example.net", topic = "kharon-audit" }
# token_file = "/run/secrets/ntfy_token"
# With a published owner UI the topic MUST be private (set token_file, use a
# reserved topic): the Approve/Deny links in its messages work from anywhere.

# Owner web UI (REQ-APR-005, #208). The owner signs in with a passkey,
# unlocks, approves and denies from a browser at its own hostname. The
# listener stays on loopback inside the holder's namespace; the tunnel
# route `kharon-owner.example.com` -> http://127.0.0.1:8788 is how the
# browser gets there. `public_origin` is the switch for public mode
# (Host check, Origin rule, throttle, `__Host-` cookie); a plain
# `origin = ...` is local mode, for an SSH forward on a host-networked
# box; never route the tunnel to it. rp_id defaults
# to the host of `public_origin`. ntfy approve/deny actions are built
# on this origin. See docs/deployment.md, "Publishing the owner UI".
[owner_ui]
listen = "127.0.0.1:8788"
public_origin = "https://kharon-owner.example.com"

# Optional second line: Cloudflare Access in front of the owner
# hostname. `audience` is the Access application's AUD tag, not its
# Client ID. kharond fetches the keys from the team domain over HTTPS.
# [owner_ui.access]
# team_domain = "myteam.cloudflareaccess.com"
# audience = "paste-the-AUD-tag-here"

# Dashboard Connect (N3, REQ-OAU-001/-002): kharond as the OAuth
# authorization server for MCP clients. Needs `public_host` set under
# [public_ingress] above and the https `public_origin` under
# [owner_ui]; kharond refuses to start otherwise. Each entry is the
# https URL of a dashboard's client metadata document (CIMD); only
# listed URLs are ever fetched. The tunnel also needs the two
# `.well-known/oauth-protected-resource` routes on the gateway host.
# See docs/deployment.md, "OAuth discovery and Connect endpoints".
# [oauth]
# clients = ["https://dashboard.example.com/.well-known/kharon-client.json"]
