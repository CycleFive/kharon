# kharond config for the compose example (SPEC §9). Every value
# below is a placeholder; kharond refuses unknown keys and refuses to
# start on unsafe combinations (REQ-DEP-003). Check a file with
#   docker compose run --rm kharon --check --config /etc/kharon.toml

[bitwarden]
# "https://vault.bitwarden.eu" for EU accounts, or "http://vaultwarden:80"
# with the `vaultwarden` compose profile.
server = "https://vault.bitwarden.com"
email = "kharon@example.net"
api_key_file = "/run/secrets/kharon_bw_api_key"
organization_id = "00000000-0000-0000-0000-000000000001"
collection_ids = ["00000000-0000-0000-0000-000000000002"]

[agents.assistant]
# `kharon token mint assistant` prints the token once (terminal only)
# and this hash on stdout. Paste the hash here; never put the token here.
token_hash = "$argon2id$..."
# The agent host's Chromium (CDP). Fills need a path to the agent's
# browser. Two ways, pick one:
#  - WireGuard (this line): needs compose.vpn.yml.
#  - Path B over WebSocket (the commented block below): the agent host
#    dials wss://<public host>/connector through the tunnel; no VPN.
# Without a path, MCP calls, grants and approvals still work.
# kharond reads the current /devtools/browser/<id> from /json/version
# on each connect, so a Chromium restart needs no edit.
cdp = { endpoint = "ws://10.66.0.2:9222", via = "wireguard" }
# Path (B) over WebSocket, egress-shaped agent host, no VPN. See
# docs/deployment.md, "Over WebSocket". connector_token_hash comes from
# `kharon tunnel mint`, not `kharon token mint`. [connector] needs
# [public_ingress] below. `listen` is left out on purpose: behind the
# tunnel nothing needs a raw port (set it only to also keep the raw
# pinned-TLS listener, on a VPN address, never a wildcard).
# cdp = { endpoint = "ws://127.0.0.1:9222", via = "agent_connector" }
# [connector]
# websocket = true
# tls_cert_file = "/etc/kharon/connector.crt"
# tls_key_file = "/etc/kharon/connector.key"

# No [api] section: the agent API is off in this base. With
# compose.vpn.yml, add (the wg address; wildcards are refused,
# REQ-DEP-006):
# [api]
# listen = "10.66.0.1:8787"

# Public gateway (#198): the origin the Cloudflare Tunnel forwards to.
# Agents reach POST /mcp here. Serves only POST /mcp (and GET
# /connector with `[connector] websocket = true`); everything else is 404. Loopback needs
# no TLS, and only what shares the holder's namespace (cloudflared)
# reaches it. Tunnel route: http://127.0.0.1:8790. See
# docs/deployment.md, "Public gateway".
[public_ingress]
listen = "127.0.0.1:8790"

[approval]
# ntfy is both the approval-prompt channel (REQ-APR-004) and the
# off-host audit checkpoint sink (REQ-AUD-002): kharond publishes a
# signed checkpoint to this topic every 100 entries or 10 minutes.
# Without this section the daemon refuses to start unless
# [audit] checkpoint_local_only = true is set instead — local-only
# checkpoints are a temporary pilot posture, not the release one.
ntfy = { url = "https://ntfy.example.net", topic = "kharon-audit" }
# token_file = "/run/secrets/ntfy_token"   # if the topic needs auth

# Owner web UI (REQ-APR-005). Left off under compose: its loopback is
# inside the holder's network namespace, out of reach of an SSH
# forward. Use the CLI (`docker compose exec kharon kharon ...`).
# Publishing it behind the edge is #208. Sign-in would be a passkey
# (`kharon passkey-enroll`); ntfy http actions (REQ-APR-004) POST to
# its listen address, e.g. http://127.0.0.1:8788/owner/approve/<token>.
# [owner_ui]
# listen = "127.0.0.1:8788"
# rp_id = "localhost"
# origin = "http://localhost:8788"
