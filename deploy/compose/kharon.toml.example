# kharond config for the compose example (SPEC §9). Every value
# below is a placeholder; kharond refuses unknown keys and refuses to
# start on unsafe combinations (REQ-DEP-003). Check a file with
#   docker compose run --rm kharon --check --config /etc/kharon.toml

[bitwarden]
server = "http://vaultwarden:80"
email = "kharon@example.net"
api_key_file = "/run/secrets/kharon_bw_api_key"
organization_id = "00000000-0000-0000-0000-000000000001"
collection_ids = ["00000000-0000-0000-0000-000000000002"]

[agents.assistant]
# `kharon token mint assistant` prints the token once (terminal only)
# and this hash on stdout. Paste the hash here; never put the token here.
token_hash = "$argon2id$..."
# The agent host's Chromium (CDP), reached over the WireGuard link.
# No path: kharond reads the current /devtools/browser/<id> from
# /json/version on each connect, so a Chromium restart needs no edit.
cdp = { endpoint = "ws://10.66.0.2:9222", via = "wireguard" }

[api]
# The wg address only; wildcards are refused (REQ-DEP-006).
listen = "10.66.0.1:8787"

[approval]
# ntfy is both the approval-prompt channel (REQ-APR-004) and the
# off-host audit checkpoint sink (REQ-AUD-002): kharond publishes a
# signed checkpoint to this topic every 100 entries or 10 minutes.
# Without this section the daemon refuses to start unless
# [audit] checkpoint_local_only = true is set instead — local-only
# checkpoints are a temporary pilot posture, not the release one.
ntfy = { url = "https://ntfy.example.net", topic = "kharon-audit" }
# token_file = "/run/secrets/ntfy_token"   # if the topic needs auth

# Owner web UI (REQ-APR-005). Loopback only; sign-in is a passkey.
# ntfy http actions (REQ-APR-004) POST here, for example
# http://127.0.0.1:8788/owner/approve/<token> (and /owner/deny/...).
# That is the owner listen address. The WireGuard agent address in
# [api] listen leaves those paths unrouted (REQ-DEP-006).
# Follow-up #128: the publisher must emit this owner host.
# Browse the origin below (localhost, not the listen IP). Enroll with
# `kharon passkey-enroll` — that code is not a password.
# [owner_ui]
# listen = "127.0.0.1:8788"
# rp_id = "localhost"
# origin = "http://localhost:8788"
